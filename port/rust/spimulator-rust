#!/usr/bin/env bash
# Run the Rust port of the spimulator engine: port/rust/target/release/
# spimulator-rust, built first (offline, standard library only) when it is
# missing or older than a source file, as the Haskell launcher does, so a
# source edit or a regenerated opcode table is never tested against an old
# binary.  Tests and example headers call this one fixed path.
#
# The engine copies its environment onto the simulated stack, so the
# program's stack addresses depend on it.  Bash adds PWD and SHLVL to the
# environment of what it runs; to hand the engine exactly the environment
# this script was given, re-read it from /proc (the kernel keeps the
# environment a process started with) and pass that on with `env -i`.
# Resolve symbolic links: tests may call this script through one.
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
binary="$here/target/release/spimulator-rust"
stale() {
    [ ! -x "$binary" ] ||
        [ -n "$(find "$here/src" "$here/Cargo.toml" -newer "$binary" -print -quit 2>/dev/null)" ]
}
if stale; then
    # Quiet unless the build fails: a test compares this command's stderr.
    log=$(mktemp)
    # An empty environment (the tests run with one) still needs a PATH.
    if ! PATH=${PATH:-/usr/local/bin:/usr/bin:/bin} cargo build --release --offline --quiet --manifest-path "$here/Cargo.toml" > "$log" 2>&1; then
        cat "$log" >&2
        rm -f "$log"
        exit 255
    fi
    rm -f "$log"
fi
if [ -r "/proc/$$/environ" ]; then
    mapfile -d '' original_environment < "/proc/$$/environ"
    exec /usr/bin/env -i "${original_environment[@]}" "$binary" "$@"
fi
exec "$binary" "$@"
