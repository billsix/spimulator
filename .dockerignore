# Trim the build context.
#
# The vendored Emacs package tree (entrypoint/dotfiles/.emacs.d/elpa) stays in git
# but is NOT baked into the image: `make shell` bind-mounts the vendored tree and
# `make update-emacs-packages` refreshes it. The rest of entrypoint/dotfiles is
# still copied to /root.
entrypoint/dotfiles/.emacs.d/elpa

# Generated by the image build itself (`make` in tree-sitter/ runs
# `tree-sitter generate` and `npm install`), so the host's copies are not needed.
tree-sitter/src/
tree-sitter/node_modules/

# VCS metadata, agent state, host build tree, image-export tarballs.
.git
.crush/
builddir/
*.tar

# A host-side build of the Haskell port (port/haskell/build.sh writes it);
# the image builds its own.
port/haskell/build/
# A host-side build of the Rust port (cargo); the image builds its own.
port/rust/target/
