# Build artifacts
builddir/
compile_commands.json

# Native teaching artifacts generated by src/Makefile:
#   *.s  — readable assembly listings (hand-written sources are
#          all *.asm, so *.s is safe to ignore)
#   *.o, *.a — assembled objects / helper archives (intermediates;
#              also covers *.debug.o and lib*-debug.a)
#   src/bin/ — the linked native demo executables
#   src/bin-debug/ — the debuggable (-g) demo executables (`make debug`)
*.s
*.o
*.a
src/bin/
src/bin-debug/

# Sphinx book outputs
output/
book/build/
book/version.txt

# Editor leftovers
*~
\#*\#
.\#*
.DS_Store

# Local debug captures (matching /spimulator's convention)
foo.txt
